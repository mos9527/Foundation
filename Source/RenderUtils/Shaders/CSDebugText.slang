[shader("compute")]
[numthreads(kFontW, kFontH, 1)]
void debugText(uint gid : SV_GroupID, uint2 gtid : SV_GroupThreadID){
    uint ch = bitfieldExtract(pc.text[gid / 4], (gid % 4) * 8, 8);
    uint offsetU = bitfieldExtract(gGlyphUOffset[ch / 2], 16 - (ch % 2) * 16, 16) + gtid.x;
    uint bitOffset = offsetU + gtid.y * 1024;
    uint col = bitfieldExtract(gGlyphBitmap[bitOffset / 32], 31 - (bitOffset % 32), 1);

    uint shadowUVOffset = max(0, bitOffset - 1024 - 1);
    uint shadowUV = bitfieldExtract(gGlyphBitmap[shadowUVOffset / 32], 31 - (shadowUVOffset % 32), 1);
    uint shadowVOffset = max(0, bitOffset - 1024 - 1);
    uint shadowV = bitfieldExtract(gGlyphBitmap[shadowVOffset / 32], 31 - (shadowVOffset % 32), 1);

    if ((shadowUV | shadowV | col) == 0) return;
    uint v = pc.col32;
    float4 fore = float4(v&255,v>>8&255,v>>16&255,v>>24&255)/255;
    float4 color = col == 1u ? fore : float4(float3(0),1);
    color.a = 1.0f;
    for (uint x=0;x < pc.scale;x++)
        for (uint y=0;y < pc.scale;y++)
            texture[(uint2(gid * kFontW, 0) + gtid) * pc.scale + uint2(x + pc.x,y + pc.y)] = color;
}